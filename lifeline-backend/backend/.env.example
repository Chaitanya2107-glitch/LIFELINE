APP_NAME=Lifeline Backend
ENVIRONMENT=development

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ─── JWT Authentication ──────────────────────────────────────
# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Standard session expiry for doctor/clerk tokens (minutes)
JWT_EXPIRE_MINUTES=60
# Short-lived token issued to patients after OTP verification (minutes)
PATIENT_JWT_EXPIRE_MINUTES=15
# How many days an approved consent grant remains valid
CONSENT_ACCESS_DURATION_DAYS=30

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── AI Configuration ────────────────────────────────────────
AI_PROVIDER=groq

# Groq (active — required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (optional — not currently active in pipeline)
GEMINI_API_KEY=

# OpenRouter (optional — not currently active in pipeline)
OPENROUTER_API_KEY=

# Google Vision (optional — not currently active in OCR pipeline)
GOOGLE_VISION_API_KEY=
